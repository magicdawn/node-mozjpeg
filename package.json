{
  "name": "node-mozjpeg",
  "version": "1.0.2",
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
  "description": "mozjpeg node binding",
  "keywords": [
    "mozjpeg",
    "binding",
    "compress"
  ],
  "license": "MIT",
  "homepage": "https://github.com/magicdawn/node-mozjpeg#readme",
  "bugs": {
    "url": "https://github.com/magicdawn/node-mozjpeg/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/magicdawn/node-mozjpeg.git"
  },
  "author": "magicdawn",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "binding.gyp",
    "index.js",
    "install",
    "package.json",
    "src",
    "types/index.d.ts"
  ],
  "main": "index.js",
  "types": "types/index.d.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "husky",
    "test": "mocha && tsd",
    "test-cover": "nyc --reporter=lcov --reporter=text mocha",
    "report-cover": "codecov",
    "gen-readme": "swig render ./readme/readme.md > README.md && prettier --write README.md",
    "build-native": "node install/build-dep.js && node-gyp rebuild",
    "build-native-ia32": "node install/build-dep.js --ia32 && node-gyp rebuild --arch ia32",
    "install": "prebuild-install --runtime=napi --target 3 || npm run build-native",
    "prebuild": "prebuild --runtime=napi --target 3"
  },
  "dependencies": {
    "bindings": "^1.5.0",
    "node-addon-api": "^8.5.0",
    "prebuild-install": "^7.1.3"
  },
  "devDependencies": {
    "@magicdawn/eslint-config": "^1.5.9",
    "@magicdawn/prettier-config": "^0.1.0",
    "@types/node": "^24.3.1",
    "benchmark": "^2.1.4",
    "blocked": "^1.3.0",
    "blocked-at": "^1.2.0",
    "bytes": "^3.1.2",
    "eslint": "^9.35.0",
    "husky": "^9.1.7",
    "lint-staged": "latest",
    "mocha": "^11.7.2",
    "napa": "^3.0.0",
    "node-gyp": "^11.4.2",
    "nyc": "^17.1.0",
    "prebuild": "^13.0.1",
    "prettier": "latest",
    "promise.sleep": "^0.2.0",
    "sharp": "^0.34.3",
    "should": "^13.2.3",
    "tsd": "^0.33.0"
  },
  "lint-staged": {
    "*.{js,ts,md}": [
      "prettier --write"
    ]
  },
  "napa": {
    "mozjpeg-src": "mozilla/mozjpeg#v3.3.1"
  },
  "binary": {
    "host": "https://cdn.jsdelivr.net/gh/magicdawn/prebuild-binary@master",
    "remote_path": "files/{name}/v{version}",
    "napi_versions": [
      3
    ]
  }
}
